{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/messages",
            "log_group_name": "/ito/{{environment}}/host",
            "log_stream_name": "{instance_id}/messages",
            "retention_in_days": 14
          },
          {
            "file_path": "/opt/ito-rnd/data/logs/api/*.log",
            "log_group_name": "/ito/{{environment}}/api",
            "log_stream_name": "{instance_id}/api",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "/ito/{{environment}}/docker",
            "log_stream_name": "{instance_id}/{container_name}",
            "retention_in_days": 14
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60,
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      }
    }
  }
}
