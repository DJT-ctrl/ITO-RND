# Reference Nginx site for ITO API (issue #14).
#
# Prefer the TLS-ready template:
#   deploy/nginx/ito-api.conf
#   sudo bash deploy/nginx/install-tls.sh <domain> <email>
#
# Runbook: docs/ops/INGRESS_HTTPS.md
#
# Legacy HTTP-only stub kept so older docs still resolve. Do **not** use this
# alone in production — it serves cleartext and fails #14 acceptance.

server {
    listen 80;
    server_name api.example.com;

    location / {
        return 301 https://$host$request_uri;
    }
}
