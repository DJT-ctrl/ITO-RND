{
  "openapi": "3.1.0",
  "info": {
    "title": "IntoTheOpen API",
    "description": "Public HTTP API for IntoTheOpen post evaluation and similarity retrieval.\n\n## Versioning\n\nAll stable integration endpoints live under **`/api/v1/`**. See\n`docs/api/VERSIONING.md` for deprecation and backward-compatibility rules.\n\n## Errors\n\nDocumented error shapes (`ApiErrorResponse`, `ValidationErrorResponse`) are\nstable for client generation. Runtime mapping to these envelopes is implemented\nin issue #7; until then, validation failures return HTTP 422 as documented and\nother failures may return a plain `detail` string.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "api_version": "v1"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "List active backend agents",
        "operationId": "list_agents_api_v1_agents_get",
        "responses": {
          "200": {
            "description": "Current backend agent registry for frontend discovery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCatalogResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "body",
                        "content"
                      ],
                      "msg": "String should have at least 1 character",
                      "type": "string_too_short"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unhandled server error (documented contract; runtime envelope in #7).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "EMBED_FAILED",
                  "message": "Failed to embed query text.",
                  "retryable": true,
                  "details": {
                    "provider": "google"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/similar-posts": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Find similar historical posts",
        "operationId": "similar_posts_api_v1_similar_posts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimilarPostsRequest"
              },
              "example": {
                "content": "Excited to share what we learned shipping our first AI feature.",
                "limit": 5
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Nearest-neighbor posts for the draft.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarPostsResponse"
                },
                "example": {
                  "query_content": "Excited to share what we learned shipping our first AI feature.",
                  "results": [
                    {
                      "post_id": "post-101",
                      "content": "Three lessons from our AI launch week\u2026",
                      "likes": 120,
                      "comments": 18,
                      "shares": 4,
                      "total_engagement": 142,
                      "engagement_percentile": 82.5,
                      "engagement_zscore": 1.1,
                      "cosine_distance": 0.08,
                      "follower_count": 4200,
                      "engagement_rate": 0.034,
                      "audience_adjusted_percentile": 79.0,
                      "hashtag_count": 2,
                      "word_count": 186,
                      "topic": "product launch",
                      "hook_type": "story"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "body",
                        "content"
                      ],
                      "msg": "String should have at least 1 character",
                      "type": "string_too_short"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unhandled server error (documented contract; runtime envelope in #7).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "EMBED_FAILED",
                  "message": "Failed to embed query text.",
                  "retryable": true,
                  "details": {
                    "provider": "google"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/evaluate": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Run the full multi-agent evaluation cycle",
        "description": "Run the async evaluation cycle end-to-end over HTTP.",
        "operationId": "evaluate_api_v1_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              },
              "example": {
                "content": "Excited to announce our new backend engineering hire!",
                "variant_strategy": "dimension",
                "reembed_variant_neighbors": false,
                "user_id": "user-42",
                "use_voice_profile": true
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Evaluation cycle result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateResponse"
                },
                "example": {
                  "draft_content": "Excited to announce our new backend engineering hire!",
                  "similar_posts": [
                    {
                      "post_id": "post-101",
                      "content": "Three lessons from our AI launch week\u2026",
                      "likes": 120,
                      "comments": 18,
                      "shares": 4,
                      "total_engagement": 142,
                      "engagement_percentile": 82.5,
                      "engagement_zscore": 1.1,
                      "cosine_distance": 0.08,
                      "follower_count": 4200,
                      "engagement_rate": 0.034,
                      "audience_adjusted_percentile": 79.0,
                      "hashtag_count": 2,
                      "word_count": 186,
                      "topic": "product launch",
                      "hook_type": "story"
                    }
                  ],
                  "voice_profile": {
                    "dominant_hook_type": "announcement",
                    "dominant_tone": "professional",
                    "dominant_writing_style": "concise",
                    "avg_word_count": 142.0,
                    "avg_hashtag_count": 1.5,
                    "cta_usage_ratio": 0.4,
                    "sample_size": 8
                  },
                  "predictor_result": {
                    "predicted_engagement_percentile": 81.0,
                    "predicted_total_engagement": 42,
                    "predicted_likes": 30,
                    "predicted_comments": 8,
                    "predicted_shares": 4,
                    "reasoning": "Neighbors with similar hiring announcements scored in the 75\u201385 percentile band."
                  },
                  "diagnostics": {
                    "seo": {
                      "score": 7.5,
                      "flaws": [
                        "Missing industry keywords in the first line"
                      ],
                      "advantages": [
                        "Clear role signal"
                      ],
                      "improvements": [
                        "Add stack or team context in the hook"
                      ]
                    },
                    "clarity": {
                      "score": 8.0,
                      "flaws": [],
                      "advantages": [
                        "Single clear announcement"
                      ],
                      "improvements": [
                        "Optional one-line benefit for the reader"
                      ]
                    },
                    "tone": {
                      "score": 7.0,
                      "flaws": [
                        "Slightly generic enthusiasm"
                      ],
                      "advantages": [
                        "Professional and approachable"
                      ],
                      "improvements": [
                        "Name the team or mission tie-in"
                      ]
                    }
                  },
                  "variants": [
                    {
                      "variant_text": "We just welcomed a backend engineer to help scale our API platform.",
                      "rationale": "Leads with outcome and team context.",
                      "strategy_label": "seo-focused",
                      "predicted_engagement_percentile": 84.0,
                      "predicted_total_engagement": 48
                    }
                  ],
                  "errors": [],
                  "embedding_model_version": "text-embedding-004"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "body",
                        "content"
                      ],
                      "msg": "String should have at least 1 character",
                      "type": "string_too_short"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unhandled server error (documented contract; runtime envelope in #7).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "EMBED_FAILED",
                  "message": "Failed to embed query text.",
                  "retryable": true,
                  "details": {
                    "provider": "google"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AgentCatalogResponse": {
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentDescriptor"
            },
            "type": "array",
            "title": "Agents"
          }
        },
        "type": "object",
        "title": "AgentCatalogResponse",
        "description": "Stable v1 contract for GET /api/v1/agents."
      },
      "AgentDescriptor": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stable machine id, e.g. predictor or seo."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Human-readable label for UI display."
          },
          "kind": {
            "type": "string",
            "enum": [
              "predictor",
              "diagnostic",
              "variant",
              "system"
            ],
            "title": "Kind",
            "description": "Agent category for iconography/grouping."
          },
          "stage": {
            "type": "string",
            "enum": [
              "setup",
              "evaluation",
              "optimization",
              "reporting",
              "monitoring"
            ],
            "title": "Stage",
            "description": "Primary workflow stage where the agent executes."
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Short plain-language purpose."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "stage",
          "description"
        ],
        "title": "AgentDescriptor",
        "description": "Agent exposed by backend for UI discovery and status mapping."
      },
      "ApiErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Machine-readable error code (e.g. EMBED_FAILED, AGENT_UNAVAILABLE)."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable summary safe to show in the UI."
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "description": "Whether the client should offer a retry action."
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "Optional structured context (field names, provider hint, etc.)."
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ApiErrorResponse",
        "description": "Documented error envelope for frontend handling (runtime wiring in #7)."
      },
      "DiagnosticResult": {
        "properties": {
          "score": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "flaws": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flaws"
          },
          "advantages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Advantages"
          },
          "improvements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Improvements"
          }
        },
        "type": "object",
        "required": [
          "score"
        ],
        "title": "DiagnosticResult",
        "description": "Single diagnostic worker output (T3.3 contract)."
      },
      "EvaluateRequest": {
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content",
            "description": "Draft post text to evaluate"
          },
          "variant_strategy": {
            "type": "string",
            "enum": [
              "dimension",
              "narrative",
              "tiered"
            ],
            "title": "Variant Strategy",
            "description": "Which distinctness axis the T3.4 Variant Optimisation Engine should use: 'dimension' (one variant per SEO/clarity/tone diagnostic), 'narrative' (different hook/story angles), or 'tiered' (safe/moderate/bold rewrite).",
            "default": "dimension"
          },
          "reembed_variant_neighbors": {
            "type": "boolean",
            "title": "Reembed Variant Neighbors",
            "description": "If true, each of the 3 variants re-embeds its own text and fetches its own nearest historical neighbors before being scored (more accurate when a variant shifts topic/angle, at the cost of up to 3 extra Gemini embed calls + DB queries). If false (default), all variants are scored against the original draft's shared neighbors (cheaper, and keeps all 3 compared against one consistent baseline).",
            "default": false
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id",
            "description": "Optional subscriber id (personalization). When given: (1) similar-post retrieval is scoped to that subscriber's own posts, falling back to the global corpus if they don't have enough yet, and (2) a derived voice profile from their top posts is injected into every agent's prompt, when enough of their own posts exist."
          },
          "use_voice_profile": {
            "type": "boolean",
            "title": "Use Voice Profile",
            "description": "Whether to derive and apply the subscriber's voice profile when user_id is given. Has no effect if user_id is not set. Set to false to scope retrieval to the subscriber without personalizing the agent prompts.",
            "default": true
          },
          "seo_mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "corpus",
                  "gemini_only"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Seo Mode",
            "description": "SEO/discoverability diagnostic mode. 'corpus' (default) grounds the SEO worker in your scraped dataset; 'gemini_only' uses the legacy static prompt for A/B testing."
          },
          "use_google_trends": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Use Google Trends",
            "description": "Tier 2: include Google Trends timeliness signals (web-wide, not LinkedIn-specific). Defaults to settings.google_trends_enabled (off unless enabled in env); always off in gemini_only."
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "EvaluateRequest"
      },
      "EvaluateResponse": {
        "properties": {
          "draft_content": {
            "type": "string",
            "title": "Draft Content"
          },
          "similar_posts": {
            "items": {
              "$ref": "#/components/schemas/SimilarPost"
            },
            "type": "array",
            "title": "Similar Posts"
          },
          "voice_profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VoiceProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "predictor_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PredictorResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "diagnostics": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DiagnosticResult"
            },
            "type": "object",
            "title": "Diagnostics",
            "description": "Diagnostic worker outputs keyed by check name (e.g. seo, clarity, tone)."
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/VariantResult"
            },
            "type": "array",
            "title": "Variants"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors",
            "description": "Non-fatal agent failures collected during the evaluation cycle."
          },
          "run_metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "query_embedding": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Embedding"
          },
          "embedding_model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Model Version"
          }
        },
        "type": "object",
        "required": [
          "draft_content"
        ],
        "title": "EvaluateResponse",
        "description": "Stable v1 response contract for POST /api/v1/evaluate."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "description": "Liveness indicator."
          },
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "description": "Stable path version for frontend integration (`/api/v1/...`).",
            "default": "v1"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "PredictorResult": {
        "properties": {
          "predicted_engagement_percentile": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Predicted Engagement Percentile"
          },
          "predicted_total_engagement": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Predicted Total Engagement"
          },
          "predicted_likes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Likes"
          },
          "predicted_comments": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Comments"
          },
          "predicted_shares": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Shares"
          },
          "reasoning": {
            "type": "string",
            "minLength": 1,
            "title": "Reasoning"
          }
        },
        "type": "object",
        "required": [
          "predicted_engagement_percentile",
          "predicted_total_engagement",
          "reasoning"
        ],
        "title": "PredictorResult",
        "description": "Engagement prediction for the draft (T3.2 contract)."
      },
      "RunMetadata": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "total_latency_ms": {
            "type": "number",
            "title": "Total Latency Ms",
            "default": 0.0
          },
          "total_cost_usd": {
            "type": "number",
            "title": "Total Cost Usd",
            "default": 0.0
          },
          "total_input_tokens": {
            "type": "integer",
            "title": "Total Input Tokens",
            "default": 0
          },
          "total_output_tokens": {
            "type": "integer",
            "title": "Total Output Tokens",
            "default": 0
          },
          "agent_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Model"
          },
          "variant_strategy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant Strategy"
          },
          "reembed_variant_neighbors": {
            "type": "boolean",
            "title": "Reembed Variant Neighbors",
            "default": false
          },
          "seo_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seo Mode"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepTelemetry"
            },
            "type": "array",
            "title": "Steps"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/TelemetryWarning"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "started_at"
        ],
        "title": "RunMetadata"
      },
      "SimilarPost": {
        "properties": {
          "post_id": {
            "type": "string",
            "title": "Post Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "likes": {
            "type": "integer",
            "title": "Likes"
          },
          "comments": {
            "type": "integer",
            "title": "Comments"
          },
          "shares": {
            "type": "integer",
            "title": "Shares"
          },
          "total_engagement": {
            "type": "integer",
            "title": "Total Engagement"
          },
          "engagement_percentile": {
            "type": "number",
            "title": "Engagement Percentile"
          },
          "engagement_zscore": {
            "type": "number",
            "title": "Engagement Zscore"
          },
          "cosine_distance": {
            "type": "number",
            "title": "Cosine Distance"
          },
          "follower_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Follower Count"
          },
          "engagement_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engagement Rate"
          },
          "audience_adjusted_percentile": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
