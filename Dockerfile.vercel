# DEPRECATED — Streamlit moved to dashboard-for-devs
#
# The ops/dev Streamlit UI now lives in:
#   https://github.com/intotheopen/dashboard-for-devs
#
# Do not build this Dockerfile from intotheopen-backend. Point Vercel at
# dashboard-for-devs instead (see that repo's README / demo notes).

FROM python:3.12-slim
CMD ["sh", "-c", "echo 'Streamlit demo moved to https://github.com/intotheopen/dashboard-for-devs' >&2; exit 1"]
