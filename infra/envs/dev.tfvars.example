environment         = "dev"
aws_region          = "eu-west-2"
instance_type       = "t3.small"
data_volume_size_gb = 40
allowed_cidrs       = ["0.0.0.0/0"]
ssh_cidrs           = []
key_name            = ""
enable_elastic_ip   = true
