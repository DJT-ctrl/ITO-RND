aws_region  = "eu-west-2"
environment = "staging"
project     = "intotheopen"

# Leave empty until ALB exists; Web ACL is still created for review.
alb_arn = ""

# Staged rollout: false = COUNT (observe), true = BLOCK (enforce).
enable_blocking = false

rate_limit_requests_per_5_minutes = 2000

# Exception CIDRs (optional):
# ip_allowlist = ["203.0.113.10/32"]
# ip_blocklist = ["198.51.100.0/24"]
